# Week 02 — provider settings for tools_shared.py
# Copy this file to .env and put the real key there. .env is gitignored.
#
# OpenRouter (OpenAI-compatible path):
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=<your-openrouter-key>
AGENT_MODEL=nvidia/nemotron-3.5-lightning:free
#
# Anthropic path instead: set ANTHROPIC_API_KEY and leave the three lines above out.
# ANTHROPIC_API_KEY=<your-anthropic-key>
